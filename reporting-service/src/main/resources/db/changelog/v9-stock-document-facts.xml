<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="v9-stock-document-facts" author="reporting">
        <createTable tableName="stock_inventory_facts">
            <column name="inventory_id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="company_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="inventory_number" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="store_id" type="INT"/>
            <column name="store_name" type="VARCHAR(255)"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="TEXT"/>
            <column name="total_lines" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="total_difference" type="DECIMAL(18,3)">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="UUID"/>
            <column name="created_by_name" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="transaction_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="ingested_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_stock_inventory_facts_company_date" tableName="stock_inventory_facts">
            <column name="company_id"/>
            <column name="transaction_date"/>
        </createIndex>
        <createIndex indexName="idx_stock_inventory_facts_store_date" tableName="stock_inventory_facts">
            <column name="store_id"/>
            <column name="transaction_date"/>
        </createIndex>

        <createTable tableName="stock_transfer_facts">
            <column name="transfer_id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="company_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="transfer_number" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="from_store_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="from_store_name" type="VARCHAR(255)"/>
            <column name="to_store_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="to_store_name" type="VARCHAR(255)"/>
            <column name="notes" type="TEXT"/>
            <column name="total_quantity" type="DECIMAL(18,3)">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="UUID"/>
            <column name="created_by_name" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="transaction_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="ingested_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_stock_transfer_facts_company_date" tableName="stock_transfer_facts">
            <column name="company_id"/>
            <column name="transaction_date"/>
        </createIndex>
        <createIndex indexName="idx_stock_transfer_facts_from_store_date" tableName="stock_transfer_facts">
            <column name="from_store_id"/>
            <column name="transaction_date"/>
        </createIndex>
        <createIndex indexName="idx_stock_transfer_facts_to_store_date" tableName="stock_transfer_facts">
            <column name="to_store_id"/>
            <column name="transaction_date"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
