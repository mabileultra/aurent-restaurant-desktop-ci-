<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="reporting-005-sale-item-facts" author="pos">
        <createTable tableName="sale_item_facts">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="sale_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="company_id" type="INT"/>
            <column name="store_id" type="INT"/>
            <column name="transaction_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="product_name" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="ingested_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_sale_item_facts_company_date" tableName="sale_item_facts">
            <column name="company_id"/>
            <column name="transaction_date"/>
        </createIndex>
        <createIndex indexName="idx_sale_item_facts_sale_id" tableName="sale_item_facts">
            <column name="sale_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
