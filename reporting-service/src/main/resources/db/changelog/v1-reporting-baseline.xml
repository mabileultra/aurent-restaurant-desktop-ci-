<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="reporting-001-sale-facts" author="pos">
        <createTable tableName="sale_facts">
            <column name="sale_id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="company_id" type="INT"/>
            <column name="store_id" type="INT"/>
            <column name="receipt_number" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="total_amount" type="NUMERIC(18,2)">
                <constraints nullable="false"/>
            </column>
            <column name="cash_amount" type="NUMERIC(18,2)">
                <constraints nullable="false"/>
            </column>
            <column name="card_amount" type="NUMERIC(18,2)">
                <constraints nullable="false"/>
            </column>
            <column name="payment_method" type="VARCHAR(32)"/>
            <column name="transaction_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="UUID"/>
            <column name="ingested_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_sale_facts_company_date" tableName="sale_facts">
            <column name="company_id"/>
            <column name="transaction_date"/>
        </createIndex>
    </changeSet>

    <changeSet id="reporting-002-stock-receipt-facts" author="pos">
        <createTable tableName="stock_receipt_facts">
            <column name="receipt_id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="company_id" type="INT"/>
            <column name="store_id" type="INT"/>
            <column name="supplier_id" type="UUID"/>
            <column name="total_amount" type="NUMERIC(18,2)">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="UUID"/>
            <column name="ingested_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_stock_receipt_facts_company_date" tableName="stock_receipt_facts">
            <column name="company_id"/>
            <column name="transaction_date"/>
        </createIndex>
    </changeSet>

    <changeSet id="reporting-003-shift-closed-facts" author="pos">
        <createTable tableName="shift_closed_facts">
            <column name="z_report_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="shift_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="company_id" type="INT"/>
            <column name="store_id" type="INT"/>
            <column name="total_sales" type="NUMERIC(18,2)">
                <constraints nullable="false"/>
            </column>
            <column name="business_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="ingested_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_shift_closed_facts_company_date" tableName="shift_closed_facts">
            <column name="company_id"/>
            <column name="business_date"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
