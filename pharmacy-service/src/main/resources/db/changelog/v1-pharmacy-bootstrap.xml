<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="pharm-001-schema-meta" author="pos">
        <createTable tableName="pharmacy_schema_meta">
            <column name="id" type="INT" defaultValueNumeric="1">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="service_version" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <insert tableName="pharmacy_schema_meta">
            <column name="id" valueNumeric="1"/>
            <column name="service_version" value="1.0.0"/>
        </insert>
    </changeSet>

</databaseChangeLog>
