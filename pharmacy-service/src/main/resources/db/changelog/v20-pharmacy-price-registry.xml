<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="pharm-200-price-registry-snapshots" author="pos">
        <createTable tableName="price_registry_snapshots">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="source_url" type="VARCHAR(1000)"/>
            <column name="file_name" type="VARCHAR(255)"/>
            <column name="registry_date" type="DATE"/>
            <column name="row_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(32)" defaultValue="READY">
                <constraints nullable="false"/>
            </column>
            <column name="error_message" type="TEXT"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_pharm_price_reg_snap_created" tableName="price_registry_snapshots">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="pharm-201-price-registry-rows" author="pos">
        <createTable tableName="price_registry_rows">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="snapshot_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="pharm_id" type="VARCHAR(64)"/>
            <column name="barcode" type="VARCHAR(64)"/>
            <column name="trade_name" type="VARCHAR(500)"/>
            <column name="limit_price_vat" type="NUMERIC(18,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="price_registry_rows"
            baseColumnNames="snapshot_id"
            referencedTableName="price_registry_snapshots"
            referencedColumnNames="id"
            constraintName="fk_pharm_price_reg_row_snap"
            onDelete="CASCADE"/>
        <createIndex indexName="idx_pharm_price_reg_row_snap" tableName="price_registry_rows">
            <column name="snapshot_id"/>
        </createIndex>
        <createIndex indexName="idx_pharm_price_reg_row_barcode" tableName="price_registry_rows">
            <column name="barcode"/>
        </createIndex>
        <createIndex indexName="idx_pharm_price_reg_row_pharm" tableName="price_registry_rows">
            <column name="pharm_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="pharm-202-price-change-journal" author="pos">
        <createTable tableName="price_change_journal">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="company_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="snapshot_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="registry_row_id" type="UUID"/>
            <column name="product_id" type="UUID"/>
            <column name="product_name" type="VARCHAR(500)"/>
            <column name="barcode" type="VARCHAR(64)"/>
            <column name="pharm_id" type="VARCHAR(64)"/>
            <column name="matched_by" type="VARCHAR(32)"/>
            <column name="old_selling_price" type="NUMERIC(18,2)"/>
            <column name="limit_price" type="NUMERIC(18,2)">
                <constraints nullable="false"/>
            </column>
            <column name="new_selling_price" type="NUMERIC(18,2)"/>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="applied_by" type="VARCHAR(32)"/>
            <column name="applied_at" type="TIMESTAMPTZ"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_pharm_price_j_company_created" tableName="price_change_journal">
            <column name="company_id"/>
            <column name="created_at"/>
        </createIndex>
        <createIndex indexName="idx_pharm_price_j_status" tableName="price_change_journal">
            <column name="company_id"/>
            <column name="status"/>
        </createIndex>
        <createIndex indexName="idx_pharm_price_j_product" tableName="price_change_journal">
            <column name="product_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
