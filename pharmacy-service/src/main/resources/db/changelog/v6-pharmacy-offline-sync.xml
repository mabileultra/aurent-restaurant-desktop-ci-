<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="pharm-030-sale-offline-sync" author="pos">
        <addColumn tableName="sales">
            <column name="client_sale_id" type="UUID"/>
            <column name="offline_device_id" type="VARCHAR(64)"/>
        </addColumn>
        <addUniqueConstraint tableName="sales" columnNames="client_sale_id"
            constraintName="uq_pharm_sales_client_sale_id"/>
        <createIndex indexName="idx_pharm_sales_client_sale" tableName="sales">
            <column name="client_sale_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
