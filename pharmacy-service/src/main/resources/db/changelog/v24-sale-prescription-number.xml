<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- AUR-18: номер электронного рецепта (длина 64 — до утверждения официального формата). -->
    <changeSet id="pharm-240-sale-prescription-number" author="pos">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="sales" columnName="prescription_number"/>
            </not>
        </preConditions>
        <addColumn tableName="sales">
            <column name="prescription_number" type="VARCHAR(64)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
