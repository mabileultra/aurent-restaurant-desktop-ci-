<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="pharm-012-store-stock-store-product-idx" author="pos">
        <createIndex indexName="idx_store_stock_store_product" tableName="store_stock">
            <column name="store_id"/>
            <column name="product_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="pharm-013-stock-marks-company-store-status-idx" author="pos">
        <createIndex indexName="idx_stock_marks_company_store_status" tableName="stock_marks">
            <column name="company_id"/>
            <column name="store_id"/>
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
