<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="pharm-090-sold-marks" author="pos">
        <createTable tableName="sale_sold_marks">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="company_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="store_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="sale_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="sale_item_id" type="UUID"/>
            <column name="mark_code" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="mark_key" type="VARCHAR(190)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="sale_sold_marks"
            columnNames="company_id, mark_key"
            constraintName="uk_pharm_sold_marks_company_key"/>
        <createIndex tableName="sale_sold_marks" indexName="idx_pharm_sold_marks_store">
            <column name="company_id"/>
            <column name="store_id"/>
        </createIndex>
        <addForeignKeyConstraint baseTableName="sale_sold_marks" baseColumnNames="sale_id"
            referencedTableName="sales" referencedColumnNames="id"
            constraintName="fk_pharm_sold_marks_sale" onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>
