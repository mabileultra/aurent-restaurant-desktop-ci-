{
  "name": "aurent-cashier-desktop",
  "version": "1.2.19",
  "private": true,
  "description": "Aurent POS Electron desktop cashier and admin",
  "main": "electron/main.js",
  "scripts": {
    "sync-icons": "node scripts/sync-icons.js",
    "bundle-ui": "node scripts/bundle-ui.js",
    "bundle-restaurant-ui": "node scripts/bundle-restaurant-ui.js",
    "start": "electron .",
    "start:test": "bash scripts/start-cashier-desktop-test.sh",
    "serve-ui": "AURENT_KEEP_UI_SERVER=1 node scripts/serve-bundled-ui.cjs",
    "pack": "npm run sync-icons && npm run bundle-ui && npm run bundle-restaurant-ui && electron-builder --dir",
    "dist": "npm run sync-icons && npm run bundle-ui && npm run bundle-restaurant-ui && electron-builder",
    "dist:win": "npm run sync-icons && npm run bundle-ui && npm run bundle-restaurant-ui && electron-builder --win",
    "dist:mac": "npm run sync-icons && npm run bundle-ui && npm run bundle-restaurant-ui && electron-builder --mac",
    "manifest": "node scripts/generate-manifest.js",
    "test": "node --test test/*.test.cjs"
  },
  "build": {
    "appId": "com.aurent.cashier",
    "productName": "Aurent Cashier",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "config/**/*",
      "build/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/sql.js/**/*",
      "node_modules/better-sqlite3/**/*",
      "electron/printers/win-raw-print.ps1",
      "electron/printers/win-raw-print-worker.ps1"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql.js/sql-wasm.wasm"
      },
      {
        "from": "ui",
        "to": "ui"
      },
      {
        "from": "ui-restaurant",
        "to": "ui-restaurant"
      }
    ],
    "mac": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.business"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "publish": {
      "provider": "generic",
      "url": "${env.UPDATE_BASE_URL}/downloads/desktop/"
    },
    "artifactName": "Aurent-Cashier-${version}-${os}-${arch}.${ext}"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "electron-updater": "^6.3.9",
    "iconv-lite": "^0.6.3",
    "node-thermal-printer": "^4.6.1",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  }
}
