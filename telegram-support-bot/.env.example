# Токен от @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# ID группы поддержки (отрицательное число, например -1001234567890)
# Как узнать: добавьте бота в группу, напишите сообщение, откройте
# https://api.telegram.org/bot<TOKEN>/getUpdates и найдите chat.id группы
TELEGRAM_SUPPORT_GROUP_ID=-1001234567890

# Секрет для доступа к backend API (тот же, что TELEGRAM_BOT_API_TOKEN в корневом .env)
TELEGRAM_BOT_API_TOKEN=change-me-bot-api-token

# Backend URL (локально — localhost, в docker — http://backend:8080/api/v1)
TELEGRAM_BOT_BACKEND_URL=http://localhost:8080/api/v1
