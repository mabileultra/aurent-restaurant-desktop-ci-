{
  "name": "aurent-restaurant-desktop",
  "version": "0.1.18",
  "private": true,
  "description": "Aurent Restaurant — local-first hall desktop (separate from Aurent Cashier)",
  "main": "electron/main.js",
  "scripts": {
    "bundle-ui": "node scripts/bundle-ui.js",
    "prepare:all": "bash ../scripts/prepare-restaurant-desktop.sh",
    "start": "electron .",
    "start:dev": "electron .",
    "pack": "npm run prepare:all && electron-builder --dir",
    "dist": "npm run prepare:all && electron-builder",
    "dist:win": "npm run prepare:all && electron-builder --win --x64",
    "dist:mac": "npm run prepare:all && electron-builder --mac --arm64 --x64",
    "manifest": "node scripts/generate-manifest.js --dist ./dist --out ../downloads/restaurant-desktop/manifest.json",
    "test": "node --test test/*.test.cjs"
  },
  "build": {
    "appId": "com.aurent.restaurant",
    "productName": "Aurent Restaurant",
    "directories": {
      "output": "dist",
      "buildResources": "nsis"
    },
    "files": [
      "electron/**/*",
      "gif.gif",
      "ra.png",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/embedded-postgres/**",
      "**/node_modules/@embedded-postgres/**"
    ],
    "extraResources": [
      {
        "from": "ui",
        "to": "ui"
      },
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "ra.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.business"
    },
    "win": {
      "icon": "ra.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "include": "installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "Aurent-Restaurant-${version}-${os}-${arch}.${ext}"
  },
  "dependencies": {
    "embedded-postgres": "18.4.0-beta.17",
    "pg": "^8.23.1"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "18.4.0-beta.17",
    "@embedded-postgres/darwin-x64": "18.4.0-beta.17",
    "@embedded-postgres/windows-x64": "18.4.0-beta.17"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
