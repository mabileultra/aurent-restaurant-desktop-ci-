# Бот поддержки для веб-приложения Aurent POS (страница «Поддержка»).
# Не путать с telegram-support-bot (аптечный: поиск лекарств).

TELEGRAM_WEB_SUPPORT_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# ID группы, куда падают обращения сотрудников POS/CRM.
# Узнать: добавить бота в группу → /getUpdates или автоподхват при первом сообщении.
TELEGRAM_WEB_SUPPORT_GROUP_ID=-1001234567890

TELEGRAM_WEB_SUPPORT_DATA_DIR=./data
