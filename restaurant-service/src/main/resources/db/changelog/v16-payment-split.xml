<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="rst-040-payment-split-amounts" author="pos">
        <addColumn tableName="floor_order_payments">
            <column name="cash_amount" type="NUMERIC(18, 2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="card_amount" type="NUMERIC(18, 2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="amount_tendered" type="NUMERIC(18, 2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="change_given" type="NUMERIC(18, 2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <sql>
            UPDATE floor_order_payments
            SET cash_amount = CASE WHEN method = 'CASH' THEN amount ELSE 0 END,
                card_amount = CASE WHEN method = 'CARD' THEN amount ELSE 0 END,
                amount_tendered = amount,
                change_given = 0
            WHERE cash_amount = 0 AND card_amount = 0;
        </sql>
    </changeSet>

</databaseChangeLog>
