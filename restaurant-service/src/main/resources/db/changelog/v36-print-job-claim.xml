<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="rst-036-print-job-claim" author="pos">
        <addColumn tableName="restaurant_print_jobs">
            <column name="claimed_at" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
        <modifyDataType tableName="restaurant_print_jobs" columnName="status" newDataType="VARCHAR(24)"/>
        <createIndex indexName="idx_rst_print_jobs_store_claimed" tableName="restaurant_print_jobs">
            <column name="company_id"/>
            <column name="store_id"/>
            <column name="status"/>
            <column name="claimed_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
