<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="rst-052-floor-orders-delivery-status" author="pos">
        <addColumn tableName="floor_orders">
            <column name="delivery_status" type="VARCHAR(24)"/>
        </addColumn>
        <sql>
            UPDATE floor_orders
            SET delivery_status = 'NEW'
            WHERE channel = 'DELIVERY' AND delivery_status IS NULL;
        </sql>
    </changeSet>

</databaseChangeLog>
