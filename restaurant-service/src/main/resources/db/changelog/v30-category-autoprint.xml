<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="v30-category-autoprint" author="aurent">
        <addColumn tableName="menu_categories">
            <column name="auto_print" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="print_station_id" type="UUID"/>
        </addColumn>
        <addForeignKeyConstraint
            baseTableName="menu_categories"
            baseColumnNames="print_station_id"
            referencedTableName="kitchen_stations"
            referencedColumnNames="id"
            constraintName="fk_menu_categories_print_station"/>
    </changeSet>

</databaseChangeLog>
