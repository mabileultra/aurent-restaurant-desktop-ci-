<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!--
        Per-printer LATERAL in claimPendingFilteredIds: the expression must match the query exactly.
        Without it each printer scans every station's pending rows (and the dead tuples left by
        PENDING→CLAIMED→DONE) — claim p95 grew to 350 ms under 2 000 inserts/s; with it ~9 ms.
    -->
    <changeSet id="rst-044-print-job-pending-printer-index" author="pos">
        <sql>
            CREATE INDEX IF NOT EXISTS idx_rst_print_jobs_pending_printer
                ON restaurant_print_jobs (
                    company_id,
                    store_id,
                    (lower(coalesce(payload::json->>'printerName', ''))),
                    created_at
                )
                WHERE status = 'PENDING';
        </sql>
    </changeSet>

</databaseChangeLog>
