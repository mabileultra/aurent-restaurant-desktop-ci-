# Опционально: nginx на хосте Ubuntu (SSL + прокси на Docker frontend :80).
# Установка: apt install nginx certbot python3-certbot-nginx
# Файл: /etc/nginx/sites-available/aurent-pos
# Ссылка: ln -s .../aurent-pos /etc/nginx/sites-enabled/

server {
    listen 80;
    server_name pos.example.uz;

    client_max_body_size 80m;

    # Редирект на HTTPS (раскомментировать после certbot)
    # return 301 https://$host$request_uri;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        proxy_pass http://127.0.0.1:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
    }
}

# HTTPS: certbot сам добавит server { listen 443 ... } — не копируйте блок вручную до выдачи сертификата.
#   apt install nginx certbot python3-certbot-nginx
#   cp deploy/nginx-host.conf.example /etc/nginx/sites-available/aurent-pos
#   ln -sf /etc/nginx/sites-available/aurent-pos /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#   certbot --nginx -d your-domain.uz
# После certbot: раскомментируйте return 301 в блоке :80 выше.
