# Опционально: nginx на хосте Ubuntu (SSL + прокси на Docker frontend :80).
# Установка: apt install nginx certbot python3-certbot-nginx
# Файл: /etc/nginx/sites-available/aurent-pos
# Ссылка: ln -s .../aurent-pos /etc/nginx/sites-enabled/

server {
    listen 80;
    server_name pos.example.uz;

    client_max_body_size 80m;

    # Редирект на HTTPS (раскомментировать после certbot)
    # return 301 https://$host$request_uri;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        proxy_pass http://127.0.0.1:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
    }
}

# После: certbot --nginx -d pos.example.uz
server {
    listen 443 ssl http2;
    server_name pos.example.uz;

    ssl_certificate /etc/letsencrypt/live/pos.example.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pos.example.uz/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 80m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        proxy_pass http://127.0.0.1:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-Id $request_id;
    }
}
