# LAB host nginx (Contabo IP) — HTTP + self-signed HTTPS, no prod domains.
# Main SPA via host :80/:443 → Docker 127.0.0.1:8088 (+ same-origin /api).
# Pharmacy SPA via Docker public :5175 (do NOT bind host nginx :5175 — port clash).
#
# .env (lab):
#   HTTP_PORT=127.0.0.1:8088
#   RESTAURANT_HTTP_PORT=127.0.0.1:5174
#   PHARMACY_HTTP_PORT=5175
#   API_PORT=8080
#   VITE_MAIN_APP_URL=http://LAB_IP
#   VITE_PHARMACY_APP_URL=http://LAB_IP:5175
#   VITE_RESTAURANT_APP_URL=http://LAB_IP:5174
#   ENABLE_TELEGRAM_BOTS=false
#
# Replace __LAB_IP__ when installing (configure-lab-host.sh).
# TLS: /etc/nginx/ssl/aurent-lab.crt + aurent-lab.key (self-signed OK for test).

upstream aurent_main_frontend {
    server 127.0.0.1:8088;
    keepalive 16;
}

upstream aurent_pharmacy_frontend {
    server 127.0.0.1:5175;
    keepalive 16;
}

upstream aurent_restaurant_frontend {
    server 127.0.0.1:5174;
    keepalive 16;
}

upstream aurent_api_gateway {
    server 127.0.0.1:8080;
    keepalive 32;
}

# --- HTTP main + same-origin /api ---
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name __LAB_IP__ _;

    client_max_body_size 80m;

    location /api/ {
        proxy_pass http://aurent_api_gateway;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    location / {
        proxy_pass http://aurent_main_frontend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}

# --- HTTPS main (self-signed; browsers may warn — OK for lab) ---
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name __LAB_IP__ _;

    ssl_certificate     /etc/nginx/ssl/aurent-lab.crt;
    ssl_certificate_key /etc/nginx/ssl/aurent-lab.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 80m;
    # No HSTS on lab — otherwise browsers lock to HTTPS forever on IP.

    location /api/ {
        proxy_pass http://aurent_api_gateway;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-Id $request_id;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    location / {
        proxy_pass http://aurent_main_frontend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-Id $request_id;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}

