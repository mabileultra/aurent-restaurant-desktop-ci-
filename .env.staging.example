# =============================================================================
# Aurent POS — staging (копия прода для проверки деплоя до production)
#   cp .env.staging.example .env.staging
#   STAGING=1 ENV_FILE=.env.staging bash deploy/deploy.sh
# =============================================================================

COMPOSE_PROJECT_NAME=aurent-pos-staging

POSTGRES_DB=pos_db_staging
POSTGRES_USER=pos_user_staging
POSTGRES_PASSWORD=CHANGE_ME_staging_pos_db

FINANCE_DB_NAME=finance_db_staging
FINANCE_DB_USER=finance_user_staging
FINANCE_DB_PASSWORD=CHANGE_ME_staging_finance_db
FINANCE_INTERNAL_API_KEY=CHANGE_ME_staging_finance_internal_key
FINANCE_SERVICE_ENABLED=true

KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
FINANCE_KAFKA_ENABLED=true
DOMAIN_KAFKA_ENABLED=true
REPORTING_KAFKA_CONSUMER_ENABLED=true

REPORTING_DB_NAME=reporting_db_staging
REPORTING_DB_USER=reporting_user_staging
REPORTING_DB_PASSWORD=CHANGE_ME_staging_reporting_db
REPORTING_INTERNAL_API_KEY=CHANGE_ME_staging_reporting_internal_key

IDENTITY_DB_NAME=identity_db_staging
IDENTITY_DB_USER=identity_user_staging
IDENTITY_DB_PASSWORD=CHANGE_ME_staging_identity_db
IDENTITY_INTERNAL_API_KEY=CHANGE_ME_staging_identity_internal_key

PLATFORM_DB_NAME=platform_db_staging
PLATFORM_DB_USER=platform_user_staging
PLATFORM_DB_PASSWORD=CHANGE_ME_staging_platform_db
PLATFORM_INTERNAL_API_KEY=CHANGE_ME_staging_platform_internal_key

CRM_DB_NAME=crm_db_staging
CRM_DB_USER=crm_user_staging
CRM_DB_PASSWORD=CHANGE_ME_staging_crm_db
CRM_INTERNAL_API_KEY=CHANGE_ME_staging_crm_internal_key

JWT_SECRET=CHANGE_ME_staging_jwt_secret_min_32_chars

SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=staging

LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=30

APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://*:*

HTTP_PORT=9080
API_PORT=9081

TZ=Asia/Tashkent

AI_ASSISTANT_ENABLED=false
MAIL_ENABLED=false

# Telegram-боты на staging по умолчанию выключены (profile staging-telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEB_SUPPORT_BOT_TOKEN=

MAIL_LOGIN_URL=http://127.0.0.1:9080/login?admin=1
BACKUP_HOST_DIR=./backups/postgres-staging
