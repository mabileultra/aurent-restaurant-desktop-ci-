<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Multi-tenant barcode uniqueness: same barcode OK across companies, unique within company. -->
    <changeSet id="v3-product-barcodes-company" author="pos">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="product_barcodes" columnName="company_id"/>
            </not>
        </preConditions>
        <addColumn tableName="product_barcodes">
            <column name="company_id" type="INT"/>
        </addColumn>
        <sql>
            UPDATE product_barcodes pb
            SET company_id = p.company_id
            FROM products p
            WHERE pb.product_id = p.id
              AND pb.company_id IS NULL;
        </sql>
        <dropUniqueConstraint
            tableName="product_barcodes"
            constraintName="product_barcodes_barcode_key"/>
        <addNotNullConstraint
            tableName="product_barcodes"
            columnName="company_id"
            columnDataType="INT"/>
        <sql>
            CREATE UNIQUE INDEX IF NOT EXISTS uq_product_barcodes_company_barcode
                ON product_barcodes (company_id, barcode);
            CREATE UNIQUE INDEX IF NOT EXISTS uq_products_company_barcode
                ON products (company_id, barcode)
                WHERE barcode IS NOT NULL;
        </sql>
    </changeSet>

</databaseChangeLog>
