<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Wave 3.1: grocery catalog schema. No stock_quantity — Inventory owns live qty. -->
    <changeSet id="v1-categories" author="pos">
        <createTable tableName="categories">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="company_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="parent_id" type="UUID"/>
            <column name="sort_order" type="INT" defaultValueNumeric="0"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="created_at" type="TIMESTAMPTZ"/>
            <column name="updated_at" type="TIMESTAMPTZ"/>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="categories" baseColumnNames="parent_id"
            referencedTableName="categories" referencedColumnNames="id"
            constraintName="fk_categories_parent"/>
        <createIndex tableName="categories" indexName="idx_categories_company">
            <column name="company_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="v1-products" author="pos">
        <createTable tableName="products">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="company_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="sku" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="category_id" type="UUID"/>
            <column name="business_type_code" type="VARCHAR(50)"/>
            <column name="product_type" type="VARCHAR(30)" defaultValue="RETAIL">
                <constraints nullable="false"/>
            </column>
            <column name="cost_price" type="DECIMAL(18,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="selling_price" type="DECIMAL(18,2)">
                <constraints nullable="false"/>
            </column>
            <column name="default_discount_percent" type="DECIMAL(5,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="tax_rate" type="DECIMAL(5,2)" defaultValueNumeric="12"/>
            <column name="sale_type" type="VARCHAR(20)" defaultValue="PIECE">
                <constraints nullable="false"/>
            </column>
            <column name="unit_code" type="VARCHAR(16)" defaultValue="PCS">
                <constraints nullable="false"/>
            </column>
            <column name="quantity_scale" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="allow_fraction" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="low_stock_alert" type="INT" defaultValueNumeric="10"/>
            <column name="barcode" type="VARCHAR(100)"/>
            <column name="plu" type="VARCHAR(5)"/>
            <column name="image_url" type="VARCHAR(500)"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="external_product_id" type="VARCHAR(100)"/>
            <column name="ikpu" type="VARCHAR(32)"/>
            <column name="ikpu_status" type="VARCHAR(30)" defaultValue="UNKNOWN"/>
            <column name="unit_of_measure" type="VARCHAR(50)"/>
            <column name="unit_measure_code" type="VARCHAR(20)"/>
            <column name="package_code" type="VARCHAR(20)"/>
            <column name="sold_individually" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="marked_product" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="storage_location" type="VARCHAR(255)"/>
            <column name="owner_type" type="VARCHAR(50)"/>
            <column name="commission_tin" type="VARCHAR(9)"/>
            <column name="commission_pinfl" type="VARCHAR(14)"/>
            <column name="uz_invoice_document_id" type="VARCHAR(64)"/>
            <column name="created_at" type="TIMESTAMPTZ"/>
            <column name="updated_at" type="TIMESTAMPTZ"/>
        </createTable>
        <addUniqueConstraint tableName="products" columnNames="company_id, sku"
                             constraintName="uq_products_company_sku"/>
        <addForeignKeyConstraint
            baseTableName="products" baseColumnNames="category_id"
            referencedTableName="categories" referencedColumnNames="id"
            constraintName="fk_products_category"/>
        <createIndex tableName="products" indexName="idx_products_company_active">
            <column name="company_id"/>
            <column name="is_active"/>
        </createIndex>
        <createIndex tableName="products" indexName="idx_products_barcode">
            <column name="barcode"/>
        </createIndex>
        <createIndex tableName="products" indexName="idx_products_plu">
            <column name="company_id"/>
            <column name="plu"/>
        </createIndex>
    </changeSet>

    <changeSet id="v1-product-barcodes" author="pos">
        <createTable tableName="product_barcodes">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="product_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="barcode" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="product_barcodes" baseColumnNames="product_id"
            referencedTableName="products" referencedColumnNames="id"
            constraintName="fk_product_barcodes_product"
            onDelete="CASCADE"/>
        <createIndex tableName="product_barcodes" indexName="idx_product_barcodes_product">
            <column name="product_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="v1-product-store-prices" author="pos">
        <createTable tableName="product_store_prices">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="product_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="store_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="DECIMAL(18,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="product_store_prices" columnNames="product_id, store_id"
                             constraintName="uq_psp_product_store"/>
        <addForeignKeyConstraint
            baseTableName="product_store_prices" baseColumnNames="product_id"
            referencedTableName="products" referencedColumnNames="id"
            constraintName="fk_psp_product"
            onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="v1-product-attributes" author="pos">
        <createTable tableName="product_attributes">
            <column name="product_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="field_key" type="VARCHAR(80)">
                <constraints nullable="false"/>
            </column>
            <column name="value_text" type="TEXT"/>
        </createTable>
        <addPrimaryKey tableName="product_attributes" columnNames="product_id, field_key"
                       constraintName="pk_product_attributes"/>
        <addForeignKeyConstraint
            baseTableName="product_attributes" baseColumnNames="product_id"
            referencedTableName="products" referencedColumnNames="id"
            constraintName="fk_product_attributes_product"
            onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
