<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="identity-012-role-module-templates" author="pos">
        <createTable tableName="role_module_templates">
            <column name="business_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="role_name" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="module_key" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="allowed" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="UUID"/>
        </createTable>
        <addPrimaryKey
            tableName="role_module_templates"
            columnNames="business_type, role_name, module_key"
            constraintName="pk_role_module_templates"/>
        <createIndex tableName="role_module_templates" indexName="idx_role_module_templates_role">
            <column name="business_type"/>
            <column name="role_name"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
