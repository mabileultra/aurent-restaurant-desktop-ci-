<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="identity-010-platform-admin-role" author="pos">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM roles WHERE name = 'PLATFORM_ADMIN'</sqlCheck>
        </preConditions>
        <insert tableName="roles">
            <column name="name" value="PLATFORM_ADMIN"/>
            <column name="description" value="Platform operator — granted super-admin sections"/>
        </insert>
    </changeSet>

</databaseChangeLog>
