# =============================================================================
# Aurent POS — production (.env на сервере: cp .env.example .env)
# =============================================================================

COMPOSE_PROJECT_NAME=aurent-pos

# --- PostgreSQL (только внутри Docker-сети) ---
POSTGRES_DB=pos_db
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# --- Finance microservice (finance_db + finance-service) ---
FINANCE_DB_NAME=finance_db
FINANCE_DB_USER=finance_user
FINANCE_DB_PASSWORD=CHANGE_ME_finance_db_password
FINANCE_INTERNAL_API_KEY=CHANGE_ME_finance_internal_api_key
FINANCE_SERVICE_ENABLED=true

# --- Kafka (Redpanda в Docker, dev: localhost:19092) ---
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
FINANCE_KAFKA_ENABLED=true
DOMAIN_KAFKA_ENABLED=true
POS_INTERNAL_API_KEY=CHANGE_ME_pos_internal_api_key
REPORTING_KAFKA_CONSUMER_ENABLED=true

# --- Reporting microservice (reporting_db + reporting-service) ---
REPORTING_DB_NAME=reporting_db
REPORTING_DB_USER=reporting_user
REPORTING_DB_PASSWORD=CHANGE_ME_reporting_db_password
REPORTING_INTERNAL_API_KEY=CHANGE_ME_reporting_internal_api_key

# --- Identity microservice (identity_db + identity-service) ---
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=CHANGE_ME_identity_db_password
IDENTITY_INTERNAL_API_KEY=CHANGE_ME_identity_internal_api_key

# --- Platform microservice (platform_db + platform-service) ---
PLATFORM_DB_NAME=platform_db
PLATFORM_DB_USER=platform_user
PLATFORM_DB_PASSWORD=CHANGE_ME_platform_db_password
PLATFORM_INTERNAL_API_KEY=CHANGE_ME_platform_internal_api_key
# Directory inside platform-service container for billing receipt uploads
BILLING_UPLOAD_DIR=/app/data/billing-uploads

# --- Click / Payme (тариф Aurent). Секреты только в .env на сервере, не в git.
BILLING_PAYMENT_RETURN_URL=https://aurent.uz/billing
CLICK_ENABLED=false
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_PAY_URL=https://my.click.uz/services/pay
PAYME_ENABLED=false
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# --- CRM microservice (crm_db + crm-service: покупатели и заказы доставки) ---
CRM_DB_NAME=crm_db
CRM_DB_USER=crm_user
CRM_DB_PASSWORD=CHANGE_ME_crm_db_password
CRM_INTERNAL_API_KEY=CHANGE_ME_crm_internal_api_key

# --- Restaurant microservice (restaurant_db + restaurant-service) ---
RESTAURANT_DB_NAME=restaurant_db
RESTAURANT_DB_USER=restaurant_user
RESTAURANT_DB_PASSWORD=CHANGE_ME_restaurant_db_password

# --- Backend ---
JWT_SECRET=CHANGE_ME_at_least_32_random_characters_long

# --- Observability (optional — leave empty to disable) ---
# Sentry: https://sentry.io — backend errors
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
# Sentry: frontend (build-time, passed to Vite)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
# Опционально: pos-frontend@1.0.0 для группировки в Sentry
# VITE_SENTRY_RELEASE=pos-frontend@1.0.0
SENTRY_RELEASE=
# Telegram alerts for deploy/health-alert.sh cron
# По умолчанию берёт уже настроенные боты (ничего нового создавать не нужно):
#   TELEGRAM_WEB_SUPPORT_BOT_TOKEN + TELEGRAM_WEB_SUPPORT_GROUP_ID
# или аптечный: TELEGRAM_BOT_TOKEN + TELEGRAM_SUPPORT_GROUP_ID
# Переопределить только если нужен отдельный канал:
# OPS_ALERT_TELEGRAM_BOT_TOKEN=
# OPS_ALERT_TELEGRAM_CHAT_ID=
OPS_ALERT_DISK_WARN_PERCENT=85
OPS_ALERT_BACKUP_MAX_AGE_HOURS=26
# Установить cron алертов при deploy.sh (health + disk + backup)
# OPS_INSTALL_HEALTH_CRON=true
# Путь к бэкапам на хосте (монтируется в backend для мониторинга)
# BACKUP_HOST_DIR=./backups/postgres

# Login brute-force protection (identity-service)
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=15

# Пул БД и Tomcat (VPS 4 vCPU / 8 GB RAM — значения по умолчанию в docker-compose.prod.yml)
# HIKARI_MAX_POOL_SIZE=25
# HIKARI_MIN_IDLE=8
# TOMCAT_MAX_THREADS=100
# Swagger на prod по умолчанию выключен. Только для отладки на сервере:
# SPRINGDOC_SWAGGER_UI_ENABLED=true
# SPRINGDOC_API_DOCS_ENABLED=true
# CORS: касса (Electron) и браузеры в LAN; при необходимости добавьте IP сервера
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://*:*,https://*:*

# --- Порты на хосте Ubuntu ---
HTTP_PORT=80
API_PORT=8080

# --- Часовой пояс ---
TZ=Asia/Tashkent

# --- Поддержка веб/десктоп (страница «Поддержка» в CRM и кассе) ---
# Username бота telegram-web-support-bot. НЕ ставить сюда аптечный бот!
SUPPORT_PHONE="+998 90 123 45 67"
SUPPORT_TELEGRAM_BOT=in_you_bot
VITE_SUPPORT_PHONE="+998 90 123 45 67"
VITE_SUPPORT_TELEGRAM_BOT=in_you_bot


# Токен бота поддержки веба (сервис telegram-web-support-bot)
TELEGRAM_WEB_SUPPORT_BOT_TOKEN=
TELEGRAM_WEB_SUPPORT_GROUP_ID=
TELEGRAM_WEB_SUPPORT_DATA_DIR=/app/data

# --- ИИ-ассистент (DeepSeek) — сервис ai-service ---
AI_ASSISTANT_ENABLED=true
AI_ASSISTANT_API_KEY=
AI_ASSISTANT_MODEL=deepseek-chat
AI_ASSISTANT_FAST_MODE=true
AI_ASSISTANT_BASE_URL=https://api.deepseek.com
AI_ASSISTANT_PROVIDER=deepseek

# --- Email (Gmail SMTP / App Password) ---
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM=your@gmail.com
MAIL_FROM_NAME="Aurent POS"
MAIL_LOGIN_URL=https://your-domain/login?admin=1
MAIL_SUPER_ADMIN_LOGIN_RECIPIENTS=admin1@gmail.com,admin2@gmail.com
MAIL_SEND_CREDENTIALS_ON_CREATE=true

# --- Telegram-бот АПТЕКИ (один общий бот) ---
# Показывает только магазины с типом PHARMACY. Добавили аптеку → сама появляется.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SUPPORT_GROUP_ID=
TELEGRAM_BOT_API_TOKEN=
TELEGRAM_BOT_MAX_RESULTS=10
TELEGRAM_BOT_BACKEND_URL=http://backend:8080/api/v1
TELEGRAM_BOT_DATA_DIR=/app/data
# Необязательно: ограничить одной компанией
# TELEGRAM_BOT_COMPANY_ID=
# Необязательно: multi-bot из БД (если нужны отдельные боты по брендам)
# TELEGRAM_BOT_RUNTIME_TOKEN=
