<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="v27-cash-register-multikassa-settings" author="pos">
        <createTable tableName="cash_register_multikassa_settings">
            <column name="cash_register_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"
                             foreignKeyName="fk_cr_multikassa_register"
                             references="cash_registers(id)"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="base_url" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="terminal_id" type="VARCHAR(128)"/>
            <column name="module_number" type="VARCHAR(128)"/>
            <column name="selected_drive_id" type="VARCHAR(128)"/>
            <column name="cashier_name_override" type="VARCHAR(200)"/>
            <column name="require_before_sale" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
    </changeSet>

    <changeSet id="v27-sales-fiscal-fields" author="pos">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="sales" columnName="fiscal_status"/>
            </not>
        </preConditions>
        <addColumn tableName="sales">
            <column name="fiscal_status" type="VARCHAR(32)" defaultValue="NOT_REQUIRED">
                <constraints nullable="false"/>
            </column>
            <column name="fiscal_sign" type="VARCHAR(128)"/>
            <column name="fiscal_receipt_seq" type="VARCHAR(64)"/>
            <column name="multikassa_sale_id" type="VARCHAR(128)"/>
            <column name="fiscal_qr_url" type="VARCHAR(1024)"/>
            <column name="fiscalized_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="fiscal_error" type="VARCHAR(1000)"/>
        </addColumn>
        <createIndex tableName="sales" indexName="idx_sales_multikassa_sale_id">
            <column name="multikassa_sale_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
