<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="v30-multikassa-print-fiscal-qr" author="pos">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="cash_register_multikassa_settings" columnName="print_fiscal_qr"/>
            </not>
        </preConditions>
        <addColumn tableName="cash_register_multikassa_settings">
            <column name="print_fiscal_qr" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="v30-sales-print-fiscal-qr" author="pos">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="sales" columnName="print_fiscal_qr"/>
            </not>
        </preConditions>
        <addColumn tableName="sales">
            <column name="print_fiscal_qr" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
