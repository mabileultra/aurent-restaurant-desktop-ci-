<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="v4-001-accountant-role" author="pos">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM roles WHERE name = 'ACCOUNTANT'</sqlCheck>
        </preConditions>
        <insert tableName="roles">
            <column name="name" value="ACCOUNTANT"/>
            <column name="description" value="Finance-only access"/>
        </insert>
    </changeSet>

</databaseChangeLog>
