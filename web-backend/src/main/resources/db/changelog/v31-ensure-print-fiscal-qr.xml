<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!--
      Failsafe: v30 мог не применить колонку на проде (GET без строки в БД работает,
      а PATCH INSERT падает 500: column print_fiscal_qr does not exist).
    -->
    <changeSet id="v31-ensure-print-fiscal-qr-columns" author="pos" dbms="postgresql">
        <sql>
            ALTER TABLE cash_register_multikassa_settings
                ADD COLUMN IF NOT EXISTS print_fiscal_qr BOOLEAN NOT NULL DEFAULT TRUE;
            ALTER TABLE sales
                ADD COLUMN IF NOT EXISTS print_fiscal_qr BOOLEAN NOT NULL DEFAULT TRUE;
        </sql>
    </changeSet>

    <changeSet id="v31-ensure-print-fiscal-qr-columns-generic" author="pos" dbms="!postgresql">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="cash_register_multikassa_settings" columnName="print_fiscal_qr"/>
            </not>
        </preConditions>
        <addColumn tableName="cash_register_multikassa_settings">
            <column name="print_fiscal_qr" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
